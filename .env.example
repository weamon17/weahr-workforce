# Firebase Web configuration (Firebase Console -> Project settings -> Your apps)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Standalone Node.js email API (see mail-server/README.md).
# Local development defaults to http://localhost:8787 when this is omitted.
# Set the deployed HTTPS URL in the production hosting environment.
VITE_MAIL_API_URL=
# Trusted Node backend for attendance + email. When omitted in development,
# both services default to http://localhost:8787.
VITE_BACKEND_API_URL=

# Used only by scripts/seed-accounts.mjs
DEFAULT_ORGANIZATION_ID=demo

# Optional read-only local demo login; active only in Vite development mode.
VITE_DEMO_ADMIN_EMAIL=admin@weahr.local
VITE_DEMO_ADMIN_PASSWORD=choose-a-local-password

# Real Firebase manager account for local write-flow testing.
# Used only by: npm run seed:test-admin
TEST_ADMIN_EMAIL=admin.test@weahr.local
TEST_ADMIN_PASSWORD=choose-a-test-password
TEST_ORGANIZATION_ID=local-test
TEST_ORGANIZATION_NAME=WeaHR Local Test
