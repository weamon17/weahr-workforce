# HTTP
PORT=8787
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173

# Gmail SMTP. Use a 16-character Google App Password, not the account password.
GMAIL_USER=weahr0426@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM_NAME=WeaHR

# Firebase Admin.
# Recommended locally: point GOOGLE_APPLICATION_CREDENTIALS to a service-account
# JSON file stored OUTSIDE this repository.
FIREBASE_PROJECT_ID=managementstaff-f0ea6
GOOGLE_APPLICATION_CREDENTIALS=C:\secure\managementstaff-service-account.json

# Alternative for hosts where a JSON file cannot be mounted:
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@managementstaff-f0ea6.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional Firebase Authentication continue URL. Add its domain to:
# Firebase Console -> Authentication -> Settings -> Authorized domains.
# AUTH_CONTINUE_URL=https://your-weahr-domain.example

# Anti-abuse controls
EMAIL_COOLDOWN_SECONDS=60
IP_WINDOW_SECONDS=900
IP_MAX_REQUESTS=10
